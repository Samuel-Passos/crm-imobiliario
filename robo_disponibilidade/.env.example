# =============================================================================
# .env — Robô de Disponibilidade (COMPLETO)
# cp .env.example .env  e preencha os valores reais
# =============================================================================

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_SERVICE_ROLE_KEY

# ── Evolution API ─────────────────────────────────────────
# URL base da sua instância Evolution API
EVOLUTION_API_URL=http://72.60.142.214:41503

# Chave de autenticação (Global API Key do seu servidor Evolution)
EVOLUTION_API_KEY=SUA_EVOLUTION_API_KEY

# Nome exato da instância conectada ao seu número
EVOLUTION_INSTANCE=n8n

# ── Groq (IA) ─────────────────────────────────────────────
GROQ_API_KEY=sua_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Configurações do Dispatcher ───────────────────────────
# Segundos entre cada mensagem enviada (mínimo recomendado: 45)
DELAY_ENTRE_ENVIOS=60

# Máximo de mensagens por execução do dispatcher
LIMITE_DIARIO=30

# ── Webhook ───────────────────────────────────────────────
# Porta local do servidor FastAPI
WEBHOOK_PORT=8766

# Segredo para validar que a requisição vem da Evolution API
WEBHOOK_SECRET=mude_para_uma_senha_secreta

# URL pública do webhook (use ngrok se não tiver IP público)
# Exemplo ngrok: https://abc123.ngrok.io/webhook
WEBHOOK_URL=https://SEU_DOMINIO_OU_NGROK/webhook

# ── Remetente (seu nome) ──────────────────────────────────
REMETENTE_NOME=Samuel

# ── Configurações# ── ADB (Motor Celular Físico) ────────────────────────────
# Tempo (s) aguardando o WhatsApp abrir após o intent
ADB_DELAY_ABERTURA=3

# Coordenadas do botão Enviar na tela do seu celular.
# Se vazio, tentará Tab/Enter pelo teclado virtual.
# Para descobrir: ative "Localização do ponteiro" nas Opções do Desenvolvedor.
ADB_TAP_X=980
ADB_TAP_Y=2163
ADB_WHATSAPP_CALL_X=902
ADB_WHATSAPP_CALL_Y=160
ADB_DELAY_ABERTURA_CALL=4

# ── SMS Config ──────────────────────────────────────────
# Coordenadas do botão Enviar no app de SMS
ADB_SMS_SEND_X=
ADB_SMS_SEND_Y=
# Limites de segurança (Anti-Bloqueio)
SMS_LIMIT_DAILY=50
SMS_BATCH_SIZE=10
SMS_DELAY_MIN=60
SMS_DELAY_MAX=180
